{
    "ts-node": {
        "transpileOnly": true,
        "esm": true,
        "moduleTypes": {
            "src/**/*.ts": "cjs"
        },
        "experimentalSpecifierResolution": "node",
        "register": true,
        "registerExtensions": ["ts-node/esm"]
    },
    "compilerOptions": {
        "module": "ESNext",
        "target": "es2017",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "outDir": "dist",
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "declaration": false,
        "strictNullChecks": true,
        "sourceMap": true,
        "moduleResolution": "node",
        "lib": ["ESNext", "DOM"]
    },
    "include": ["src", "mochaSetup.js"],
    "exclude": [
        "coverage",
        "dist"
    ]
}
