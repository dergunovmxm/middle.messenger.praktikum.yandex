{
    "ts-node": {
        "transpileOnly": true,
        "esm": true,
        "moduleTypes": {
            "src/**/*.ts": "cjs"
        }
    },
    "compilerOptions": {
        "outDir": "dist",
        "target": "es2017",
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "declaration": false,
        "module": "commonjs",
        "strictNullChecks": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "moduleResolution": "node"
    },
    "include": ["src", "**/*.ts", "mochaSetup.js"],
    "exclude": ["node_modules", "coverage", "dist"]
}
