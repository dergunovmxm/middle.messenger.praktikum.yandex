{
  "name": "chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.cjs",
    "start": "run-s build server",
    "lint:types": "tsc --noemit",
    "lint:js": "eslint src/ --ext .ts,.tsx --fix --cache --cache-strategy metadata",
